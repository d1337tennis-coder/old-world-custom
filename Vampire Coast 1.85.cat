		<profile name="Varghulf"
		         typeId="b070-143a-73f-2772"
		         typeName="Model"
		         hidden="false"
		         id="108d-f743-d0f9-b8f0">
			<characteristics>
				<characteristic name="M"
				                typeId="cd3b-a5a4-e185-5a9d">8</characteristic>
				<characteristic name="WS"
				                typeId="b007-7d58-4f14-1e01">5</characteristic>
				<characteristic name="BS"
				                typeId="59f9-ccf5-1155-fb05">0</characteristic>
				<characteristic name="S"
				                typeId="5b6b-1427-2a45-dd0c">5</characteristic>
